default_platform(:ios)

# Lanes below assume fastlane/.env (gitignored) defines:
#   FASTLANE_APPLE_ID            developer Apple ID
#   FASTLANE_TEAM_ID             Developer Program team ID (signing)
#   FASTLANE_ITC_TEAM_ID         App Store Connect team ID (often same)
#   PUMICE_BUNDLE_ID             ca.polivoxia.Pumice
#   ASC_KEY_ID                   App Store Connect API key ID
#   ASC_ISSUER_ID                App Store Connect issuer ID
#   ASC_KEY_PATH                 absolute path to the .p8 key file

REPO_ROOT       = File.expand_path("..", __dir__)
XCODE_PROJECT   = File.join(REPO_ROOT, "Pumice.xcodeproj")
SCHEME          = "Pumice"
OUTPUT_DIR      = File.join(REPO_ROOT, "build", "fastlane")

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    duration: 1200,
    in_house: false
  )
end

def regenerate_project
  Dir.chdir(REPO_ROOT) do
    sh("xcodegen", "generate")
  end
end

platform :ios do
  desc "Capture App Store screenshots on the iPad Pro 13\" simulator via PumiceUITests."
  lane :screenshots do
    regenerate_project
    snapshot(
      project: XCODE_PROJECT,
      scheme: "PumiceUITests",
      output_directory: File.join(REPO_ROOT, "fastlane", "screenshots"),
      clear_previous_screenshots: true,
      stop_after_first_error: true,
      override_status_bar: true
    )
  end

  desc "Create or download the Apple Distribution cert and App Store profile."
  lane :setup_signing do
    api_key = asc_api_key
    bundle_id = ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice"
    out = File.join(REPO_ROOT, "build", "signing")
    FileUtils.mkdir_p(out)
    cert(
      api_key: api_key,
      output_path: out,
      generate_apple_certs: true
    )
    sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      output_path: out,
      filename: "Pumice_AppStore.mobileprovision",
      force: false
    )
  end

  desc "Build a Release archive and export an App Store .ipa."
  lane :build do
    regenerate_project
    profile_path = File.join(REPO_ROOT, "build", "signing", "Pumice_AppStore.mobileprovision")
    profile_uuid = nil
    if File.exist?(profile_path)
      require "plist"
      raw = File.read(profile_path, mode: "rb")
      plist_data = raw[raw.index("<?xml")..raw.index("</plist>") + 7]
      profile_uuid = Plist.parse_xml(plist_data)["UUID"]
    end
    bundle_id = ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice"
    export_options = {
      signingStyle: "manual",
      teamID: ENV.fetch("FASTLANE_TEAM_ID"),
      provisioningProfiles: { bundle_id => profile_uuid }
    }
    gym(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: OUTPUT_DIR,
      output_name: "Pumice.ipa",
      export_method: "app-store",
      export_options: export_options
    )
  end

  desc "Upload .ipa + text metadata to App Store Connect. No screenshots, no submit."
  lane :upload do
    deliver(
      api_key: asc_api_key,
      ipa: File.join(OUTPUT_DIR, "Pumice.ipa"),
      app_identifier: ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      skip_metadata: false,
      skip_screenshots: true,
      skip_app_version_update: false,
      skip_binary_upload: false,
      run_precheck_before_submit: false,
      # Skip review-detail upload — fastlane 2.230 crashes when no detail row
      # exists yet for a fresh App Store Connect record. Set it in the web UI
      # after the first upload.
      app_review_information: nil
    )
  end

  desc "Upload only the screenshots to App Store Connect."
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      app_identifier: ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: false,
      skip_binary_upload: true,
      run_precheck_before_submit: false
    )
  end

  desc "Push the App Store submission for review. Run after upload + screenshots."
  lane :submit do
    deliver(
      api_key: asc_api_key,
      app_identifier: ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        content_rights_contains_third_party_content: false
      },
      run_precheck_before_submit: false
    )
  end

  desc "Full pipeline: build, upload, then submit for review."
  lane :release do
    regenerate_project
    build
    deliver(
      api_key: asc_api_key,
      ipa: File.join(OUTPUT_DIR, "Pumice.ipa"),
      app_identifier: ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        content_rights_contains_third_party_content: false
      },
      run_precheck_before_submit: false
    )
  end

  desc "Hit App Store Connect with the API key to confirm authentication works."
  lane :asc_check do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: File.read(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice")
    if app.nil?
      UI.user_error!("App with bundle id #{ENV['PUMICE_BUNDLE_ID']} not found in App Store Connect.")
    end
    UI.success("App Store Connect reachable. App: #{app.name} (#{app.bundle_id}), id=#{app.id}")
  end

  desc "Create or update the App Review contact info on the editable version."
  lane :seed_review_detail do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: File.read(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice")
    UI.user_error!("App not found") if app.nil?
    version = app.get_edit_app_store_version
    UI.user_error!("No editable App Store version found.") if version.nil?

    attrs = {
      "contact_first_name" => ENV["REVIEW_FIRST_NAME"] || "Pumice",
      "contact_last_name" => ENV["REVIEW_LAST_NAME"] || "Support",
      "contact_email" => ENV["REVIEW_EMAIL"] || ENV["FASTLANE_APPLE_ID"] || "aemjcr@gmail.com",
      "contact_phone" => ENV["REVIEW_PHONE"].to_s.empty? ? "+1 604 555 0123" : ENV["REVIEW_PHONE"],
      "demo_account_name" => "",
      "demo_account_password" => "",
      "demo_account_required" => false,
      "notes" => "Pumice is a fully local PDF annotation app. No account, no network, no demo credentials. Open any folder of PDFs via the Files picker."
    }
    existing = begin
                 version.fetch_app_store_review_detail
               rescue
                 nil
               end
    if existing
      existing.update(attributes: attrs)
      UI.success "Updated review detail."
    else
      version.create_app_store_review_detail(attributes: attrs)
      UI.success "Created review detail."
    end
  end

  desc "Inspect the live App Store Connect record so we know what state it's in."
  lane :asc_inspect do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: File.read(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(ENV["PUMICE_BUNDLE_ID"] || "ca.polivoxia.Pumice")
    UI.user_error!("App not found") if app.nil?
    UI.message "App: #{app.name} (#{app.bundle_id}), id=#{app.id}"
    UI.message "Primary locale: #{app.primary_locale}"
    UI.message "Bundle ID: #{app.bundle_id}"

    info = app.fetch_latest_app_info
    if info
      UI.message "App Info id=#{info.id} state=#{info.app_store_state}"
      info.get_app_info_localizations.each do |loc|
        UI.message "  app_info_localization locale=#{loc.locale} name=#{loc.name.inspect} subtitle=#{loc.subtitle.inspect}"
      end
    end

    versions = app.get_app_store_versions
    versions.each do |ver|
      UI.message "Version #{ver.version_string} state=#{ver.app_store_state}"
      ver.get_app_store_version_localizations.each do |loc|
        UI.message "  version_localization locale=#{loc.locale} description=#{(loc.description || '').slice(0, 50)}..."
      end
    end
  end

  desc "Sanity-check the local environment before running release."
  lane :preflight do
    required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH FASTLANE_APPLE_ID FASTLANE_TEAM_ID FASTLANE_ITC_TEAM_ID]
    missing = required.reject { |k| ENV[k] && !ENV[k].empty? }
    UI.user_error!("Missing env vars: #{missing.join(', ')}") if missing.any?
    UI.success("All required env vars present.")

    key_path = ENV["ASC_KEY_PATH"]
    UI.user_error!(".p8 file not found at #{key_path}") unless File.exist?(key_path)
    UI.success(".p8 key file present.")

    config_path = File.join(REPO_ROOT, "Config", "Local.xcconfig")
    UI.user_error!("Config/Local.xcconfig missing") unless File.exist?(config_path)
    config = File.read(config_path)
    if config !~ /DEVELOPMENT_TEAM\s*=\s*#{Regexp.escape(ENV.fetch('FASTLANE_TEAM_ID'))}/
      UI.important("Config/Local.xcconfig DEVELOPMENT_TEAM does not match FASTLANE_TEAM_ID; archive will fail.")
    else
      UI.success("Signing team matches.")
    end
  end
end
