# Copy to fastlane/.env, fill in, do not commit.
#
# Apple ID this developer account signs in with.
FASTLANE_APPLE_ID=
#
# Developer Program team ID (from developer.apple.com -> Membership -> Team ID).
# This must match Config/Local.xcconfig DEVELOPMENT_TEAM.
FASTLANE_TEAM_ID=
#
# App Store Connect team ID. Often the same string as FASTLANE_TEAM_ID,
# but App Store Connect treats it as a distinct field.
FASTLANE_ITC_TEAM_ID=
#
# Bundle ID. Override only if the project ships under a different identifier.
PUMICE_BUNDLE_ID=ca.polivoxia.Pumice
#
# App Store Connect API key, generated in
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# Role: App Manager. Download the .p8 file once; it cannot be re-downloaded.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
#
# Review contact info, surfaced to the App Review team only.
REVIEW_FIRST_NAME=Adriana
REVIEW_LAST_NAME=Miranda
REVIEW_EMAIL=
REVIEW_PHONE=
