          "items": {
            "type": "object",
            "properties": {
              "concept_id": {
                "type": "string",
                "minLength": 1
              },
              "label_ko": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_attempt_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "required": [
              "concept_id",
              "label_ko",
              "score",
              "evidence_attempt_ids"
            ],
            "additionalProperties": false
          }
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": {
                "type": "string",
                "format": "uuid"
              },
              "front_ko": {
                "type": "string",
                "minLength": 1
              },
              "back_ko": {
                "type": "string",
                "minLength": 1
              },
              "due_at": {
                "type": "string",
                "format": "date-time"
              },
              "review_count": {
                "type": "integer",
                "maximum": 9007199254740991,
                "minimum": 0
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "models.schema.json#/$defs/VerifiedCitation"
                },
                "minItems": 1
              }
            },
            "required": [
              "memory_id",
              "front_ko",
              "back_ko",
              "due_at",
              "review_count",
              "citations"
            ],
            "additionalProperties": false
          }
        },
        "progress": {
          "type": "object",
          "properties": {
            "last_page_index": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            "pages_read": {
              "type": "array",
              "items": {
                "type": "integer",
                "maximum": 9007199254740991,
                "minimum": 0
              },
              "uniqueItems": true
            },
            "reading_seconds": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            "next_review_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "last_page_index",
            "pages_read",
            "reading_seconds",
            "next_review_at"
          ],
          "additionalProperties": false
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "activity_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "chat",
                  "reading",
                  "quiz",
                  "assessment",
                  "mastery",
                  "solve",
                  "memory",
                  "progress",
                  "review"
                ]
              },
              "turn_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "description": "Opaque native DeepTutor turn ID, e.g. turn_<milliseconds>_<hex>; do not parse as UUID."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary_ko": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "activity_id",
              "kind",
              "turn_id",
              "summary_ko",
              "created_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "document_id",
        "version_id",
        "learning_revision",
        "quiz_attempts",
        "mastery",
        "memory",
        "progress",
        "activities"
      ],
      "additionalProperties": false
    },
    "PublicSettings": {
      "type": "object",
      "properties": {
        "server_revision": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "provider": {
          "type": "object",
          "properties": {
            "adapter": {
              "const": "openai-compatible"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "credential_configured": {
              "type": "boolean"
            }
          },
          "required": [
            "adapter",
            "base_url",
            "model",
            "credential_configured"
          ],
          "additionalProperties": false
        },
        "response_language": {
          "type": "string",
          "pattern": "^(und|[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*)$"
        }
      },
      "required": [
        "server_revision",
        "provider",
        "response_language"
      ],
      "additionalProperties": false
    },
    "SettingsWrite": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "object",
          "properties": {
            "adapter": {
              "const": "openai-compatible"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "api_key": {
              "type": "string",
              "minLength": 1,
              "writeOnly": true
            }
          },
          "required": [
            "adapter",
            "base_url",
            "model"
          ],
          "additionalProperties": false
        },
        "response_language": {
          "type": "string",
          "pattern": "^(und|[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*)$"
        }
      },
      "required": [
        "provider",
        "response_language"
      ],
      "additionalProperties": false
    },
    "PairRequest": {
      "type": "object",
      "properties": {
        "one_time_code": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "device_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "one_time_code",
        "device_name"
      ],
      "additionalProperties": false
    },
    "PairReceipt": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "access_token": {
          "type": "string",
          "minLength": 32
        },
        "token_type": {
          "const": "Bearer"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "device_id",
        "access_token",
        "token_type",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "ExportRequest": {
      "type": "object",
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "annotation_revision": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "include_ink": {
          "type": "boolean"
        }
      },
      "required": [
        "version_id",
        "annotation_revision",
        "include_ink"
      ],
      "additionalProperties": false
    },
    "ExportReceipt": {
      "type": "object",
      "properties": {
        "export_id": {
          "type": "string",
          "format": "uuid"
        },
        "download_path": {
          "type": "string",
          "pattern": "^/v1/exports/[a-f0-9-]+/file$"
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "export_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "export_id",
        "download_path",
        "original_sha256",
        "export_sha256"
      ],
      "additionalProperties": false
    }
  }
}
